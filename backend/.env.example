APP_NAME="CIS CWIE Hub"
APP_VERSION=1.0.0

DATABASE_URL=postgresql://postgres:password@localhost:5432/cis_cwie_hub

SECRET_KEY=change-me-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

REDIS_URL=redis://localhost:6379

# Resend Email Configuration (OTP Delivery)
# Get your API key from https://resend.com
# Verify a sender domain or email at https://resend.com/domains before real emails can be delivered
# Never commit real values to Git; fill in real credentials in your local .env only
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=otp@your-verified-domain.com

FRONTEND_URL=http://localhost:3000