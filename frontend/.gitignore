# ============================
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/

# ============================
# Vercel
# ============================
.vercel/

# ============================
# Environment Variables
# ============================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# ============================
# Dependencies
# ============================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
yarn.lock
package-lock.json
pnpm-lock.yaml

# ============================
# Next.js
# ============================
.next/
out/
*.tsbuildinfo
next-env.d.ts
.turbo/

# ============================
# Build
# ============================
dist/
build/
*.map

# ============================
# Testing
# ============================
coverage/
.nyc_output/
coverage.json

# ============================
# Cache
# ============================
.cache/
.eslintcache
.stylelintcache

# ============================
# IDE
# ============================
.vscode/
.idea/
*.swp
*.swo
*~
*.iml

# ============================
# OS
# ============================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ============================
# Logs
# ============================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ============================
# TypeScript
# ============================
*.tsbuildinfo

# ============================
# Temporary Files
# ============================
*.tmp
*.temp
tmp/
temp/

# ============================
# Storybook (if used)
# ============================
.storybook/
storybook-static/

# ============================
# !! SECURITY - environment & secrets !!
# ============================
.env
.env.*
!*.env.example
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials.json
*credential*.json
service-account*.json
*serviceAccount*.json
*.token
*.secret
*.secrets
secrets.json
.secrets/
.npmrc

# ============================
# Node / Next.js extras
# ============================
.swc/
.pnpm-store/
.pnpm-debug.log*
.npm/
.yarn/cache
.yarn/unplugged
.turbo/
.vercel/
*.local

# ============================
# Keep reproducible builds & Next.js types tracked
# (overrides the rules above, which would otherwise hide them)
# ============================
!package-lock.json
!next-env.d.ts
